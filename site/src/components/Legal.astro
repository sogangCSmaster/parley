---
// 약관·개인정보·환불 페이지의 공통 틀(영어만). 머리 막대, 제목, 초안 안내, 목차(있으면), 본문, 바닥 줄.
import Base from '../layouts/Base.astro'
import Mark from './Mark.astro'
import { en } from '../i18n/en'
import '../styles/legal.css'

type Page = 'privacy' | 'terms' | 'refund'
interface Props {
  page: Page
  title: string
  metaTitle: string
  metaDescription: string
  updated: string
  /** [id, 목차 이름]. 없으면 목차 없이 한 단으로 놓는다. */
  toc?: [string, string][]
}
const { page, title, metaTitle, metaDescription, updated, toc } = Astro.props
const links: [Page, string][] = [['privacy', 'Privacy'], ['terms', 'Terms'], ['refund', 'Refunds']]
const href = (p: Page) => `/${p}/`
// Base는 hreflang 대안을 언어별 첫 페이지로 건다. 이 페이지들은 영어 하나뿐이라 그 대안이 틀리고,
// 아직 법무 검토 전 초안이므로 noindex로 둔다(대표 주소·대안 링크도 함께 빠진다).
const t = { ...en, metaTitle, metaDescription, path: href(page) }
---
<Base t={t} noindex>
  <div class="legal">
    <nav class="legal-top" aria-label="Main">
      <a class="brand" href="/" aria-label="Tolkmeet home"><Mark size={22} /><span>tolkmeet</span></a>
      <span class="legal-links">
        {links.map(([p, label]) => <a href={href(p)} aria-current={p === page ? 'page' : undefined}>{label}</a>)}
      </span>
    </nav>

    <main>
      {toc ? (
        <>
          <header class="legal-head">
            <h1>{title}</h1>
            <p class="legal-date">{updated}</p>
            <p class="legal-draft">Draft for legal review. Not yet in effect.</p>
          </header>
          <div class="legal-body has-toc">
            <nav class="legal-toc" aria-label="On this page">
              <span class="legal-toc-title">On this page</span>
              {toc.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
            </nav>
            <article class="legal-text"><slot /></article>
          </div>
        </>
      ) : (
        <article class="legal-text legal-single">
          <h1>{title}</h1>
          <p class="legal-date">{updated}</p>
          <p class="legal-draft">Draft for legal review. Not yet in effect.</p>
          <slot />
        </article>
      )}
    </main>

    <footer class="legal-foot">
      © 2026 [COMPANY NAME]{links.map(([p, label]) => <> · <a href={href(p)}>{label}</a></>)}
    </footer>
  </div>
</Base>
