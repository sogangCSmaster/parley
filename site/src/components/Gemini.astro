---
// Gemini 반짝임 표시. 한 페이지에 여러 번 쓰므로 그라데이션 id를 호출마다 다르게 준다.
interface Props { id: string; size?: number }
const { id, size = 18 } = Astro.props
---
<svg class="gem" width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  <defs><linearGradient id={id} x1="0" y1="0" x2="24" y2="24" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#4285F4" /><stop offset=".55" stop-color="#9B72CB" /><stop offset="1" stop-color="#D96570" /></linearGradient></defs>
  <path d="M12 0C12 6.627 17.373 12 24 12C17.373 12 12 17.373 12 24C12 17.373 6.627 12 0 12C6.627 12 12 6.627 12 0Z" fill={`url(#${id})`} />
</svg>
