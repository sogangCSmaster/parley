---
// 브랜드 마크 "Pair": 원문(위)과 번역(아래)이 비켜 놓인 두 줄. 앱의 BrandMark.tsx와 같은 모양.
interface Props { size?: number }
const { size = 32 } = Astro.props
---
<svg class="mark" width={size} height={size} viewBox="0 0 96 96" aria-hidden="true" focusable="false">
  <rect x="8" y="28" width="62" height="16" rx="8" fill="var(--brand-ink)" />
  <rect x="26" y="52" width="62" height="16" rx="8" fill="var(--brand-accent)" />
</svg>
